# Este archivo es también el EnvironmentFile de systemd en los servidores desplegados.
# En local, expórtalo antes de arrancar (`set -a; . ./.env; set +a`) o cárgalo desde el IDE.

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docurural_db
DB_USER=docurural
DB_PASSWORD=

# JWT (generar secret de >=32 bytes aleatorios)
JWT_SECRET=
JWT_EXPIRATION_MS=1800000
JWT_ISSUER=docurural

# Admin inicial (solo se usa en primer arranque; operación idempotente)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Seguridad
DOCURURAL_BCRYPT_STRENGTH=12

# Almacenamiento de archivos (todos los entornos usan S3, incluido el perfil local)
DOCURURAL_STORAGE_PROVIDER=s3
DOCURURAL_STORAGE_BASE_PATH=./uploads/documents
DOCURURAL_STORAGE_MAX_FILE_SIZE=10MB
DOCURURAL_STORAGE_MAX_REQUEST_SIZE=55MB
# En local, vacío = bucket de develop (docurural-develop-documentos) con prefijo documents/local
DOCURURAL_STORAGE_S3_BUCKET=
AWS_REGION=us-east-1
DOCURURAL_STORAGE_S3_KEY_PREFIX=documents

# AWS Parameter Store
# El perfil `local` no usa AWS Parameter Store (spring.cloud.aws.parameterstore.enabled=false);
# db-password y jwt-secret salen de las variables de entorno de arriba.
# develop, qa y prod importan /docurural/<entorno>/ desde Parameter Store — en esos entornos
# DB_PASSWORD, JWT_SECRET y DOCURURAL_STORAGE_S3_BUCKET NO se definen aquí, llegan de SSM.

# Perfil Spring
SPRING_PROFILES_ACTIVE=local

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200
